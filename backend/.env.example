# Node Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# E.g., mongodb://localhost:27017/buildnexus
MONGO_URI=mongodb://localhost:27017/buildnexus

# Authentication
# Secret key for signing JWT tokens (Change this in production)
JWT_SECRET=supersecretjwtkey_buildnexus

# AI Integration (Groq)
# Obtain your free key from Groq: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Internal ML Microservice (Python)
ML_SERVICE_URL=http://127.0.0.1:5001
